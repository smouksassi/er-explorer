{
  "name": "@er-explorer/data",
  "version": "0.0.1",
  "private": false,
  "description": "Data engine for ER Explorer: immutable wide dataset loading, automatic type inference, and lazy derived analysis views.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck && vitest run",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@er-explorer/domain": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "files": ["dist"],
  "keywords": ["er-explorer", "data", "dataset"],
  "license": "MIT"
}
