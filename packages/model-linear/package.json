{
  "name": "@er-explorer/model-linear",
  "version": "0.0.1",
  "private": false,
  "description": "Linear regression (OLS) AnalysisModel plugin for ER Explorer's continuous exposure-response endpoints.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck && vitest run",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@er-explorer/analysis": "workspace:*",
    "@er-explorer/domain": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "files": ["dist"],
  "keywords": ["er-explorer", "analysis", "linear", "ols", "plugin"],
  "license": "MIT"
}
