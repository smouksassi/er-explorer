{
  "name": "@er-explorer/session-engine",
  "version": "0.0.1",
  "private": false,
  "description": "Session engine (reproducibility engine) for ER Explorer: the versioned, checksummed .erx session file format.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck && vitest run",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@er-explorer/domain": "workspace:*",
    "@er-explorer/analysis": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "files": ["dist"],
  "keywords": ["er-explorer", "session", "reproducibility", "erx"],
  "license": "MIT"
}
